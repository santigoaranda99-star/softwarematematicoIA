# Entorno virtual
venv/
.venv/

# Archivos compilados de Python
__pycache__/
*.pyc
*.pyo
*.py[cod]

# Configuración de la IA (nunca subir claves)
.env

# Base de datos local
database/*.db
software_matematico.db

