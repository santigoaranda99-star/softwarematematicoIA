# =====================================================
# Configuración de la Inteligencia Artificial
# Copie este archivo como ".env" y complete sus valores.
# =====================================================

# Clave de acceso a la API (proporcionada por su proveedor)
# Si usa Groq: https://console.groq.com/keys
GROUP_API_KEY=

# URL base del proveedor (API compatible con OpenAI).
# Ejemplos:
#   Groq:    https://api.groq.com/openai/v1
#   OpenAI:  https://api.openai.com/v1
GROUP_BASE_URL=

# Modelo a utilizar (según disponibilidad del proveedor).
# Si usa Groq, recomendado (texto + imagen ultra-rápido): qwen/qwen3.8-27b
GROUP_MODEL=qwen/qwen3.8-27b

